HERMES_WSL_DISTRO=Ubuntu
HERMES_COMMAND=hermes
HERMES_PROVIDER=openrouter
HERMES_MODEL=openai/gpt-5.4-mini
HERMES_SESSION_NAME=jarvis_voice_assistant
HERMES_EXTRA_FLAGS=--ignore-rules --accept-hooks --source tool
HERMES_TIMEOUT=60
HERMES_MAX_TURNS=6

# Tool-action policy: balanced confirms changes, strict confirms every tool request, off disables prompts.
PERMISSION_MODE=balanced
PERMISSION_TIMEOUT=120

# Optional: enables the direct low-latency route for ordinary conversation.
OPENROUTER_API_KEY=
FAST_MODEL=openai/gpt-5.4-nano
FAST_TIMEOUT=30

WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_VAD_FILTER=true
AUDIO_SAMPLE_RATE=16000

TTS_ENGINE=pyttsx3
TTS_VOICE=
TTS_RATE=190
TTS_FAST_RATE=230
TTS_FAST_WORD_THRESHOLD=50
HOTKEY=f8
DEFAULT_PERSONALITY=jarvis
PERSONALITIES_DIR=personalities
MEMORY_DB_PATH=data/jarvis_memory.db
